# ============================================================================
# Soleil / Mallorca — variables de entorno
# Copiar a .env y ajustar. El archivo .env NO se versiona.
# ============================================================================

# --- Aplicación ---
APP_NAME=Soleil ERP
APP_ENV=development          # development | production
DEBUG=true
TIMEZONE=America/Argentina/Buenos_Aires

# --- Base de datos ---
POSTGRES_USER=soleil
POSTGRES_PASSWORD=soleil
POSTGRES_DB=soleil
POSTGRES_HOST=db             # "db" dentro de docker-compose; "localhost" fuera
POSTGRES_PORT=5432
POSTGRES_PORT_HOST=5432      # puerto publicado en el host

# --- Puertos del host para el backend ---
# Cambiarlos si otro proyecto ya ocupa esos puertos en la máquina.
# El puerto interno del contenedor siempre es 8000.
BACKEND_PORT_HOST=8000       # desarrollo
BACKEND_PORT_PROD=80         # producción

# --- JWT ---
# Generar una clave nueva con: openssl rand -hex 32
JWT_SECRET=cambiar-esta-clave-en-produccion
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_MINUTES=30
JWT_REFRESH_TOKEN_DAYS=7

# Secure=true exige HTTPS: false en desarrollo, true en producción.
COOKIE_SECURE=false

# --- CORS (lista separada por comas) ---
CORS_ORIGINS=http://localhost:8000,http://localhost

# --- SMTP (recuperación de contraseña — opcional en desarrollo) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@soleil.local
SMTP_TLS=true


# ============================================================================
# PRODUCCIÓN (Railway u otro PaaS)
#
# Todo lo de arriba es para desarrollo con docker-compose. En un PaaS las
# variables se cargan en el panel del servicio, no en un .env, y cambian
# estas:
#
#   DATABASE_URL    ${{Postgres.DATABASE_URL}}   referencia al servicio de BD
#   APP_ENV         production                   oculta /docs y /openapi.json
#   DEBUG           false
#   JWT_SECRET      openssl rand -hex 32         NUNCA el valor de ejemplo
#   COOKIE_SECURE   true
#   APP_URL         https://<dominio>
#   CORS_ORIGINS    https://<dominio>
#
# NO hace falta configurar:
#   PORT              lo inyecta la plataforma; entrypoint.sh lo lee solo
#   POSTGRES_*        los reemplaza DATABASE_URL
#   BACKEND_PORT_*    son de docker-compose; config.py ni los lee
#
# Dos cosas que no son variables y hay que resolver igual:
#
#   1. Las fotos de producto se escriben en app/static/productos. Ese
#      directorio necesita un volumen persistente o se borran en cada deploy.
#   2. La contraseña inicial de 'admin' está en migrations/seed.sql. El
#      sistema obliga a cambiarla en el primer login, pero conviene hacerlo
#      apenas termine el despliegue.
# ============================================================================
